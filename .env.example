# eBay: create a "Production" keyset at https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional: EBAY_GB (default, eBay UK), EBAY_US, EBAY_DE, EBAY_IE, EBAY_AU, ...
EBAY_MARKETPLACE=EBAY_GB
# Optional: production (default) or sandbox
EBAY_ENV=production
# Optional: your postcode so eBay can estimate postage and delivery dates, e.g. "SW1A 1AA"
EBAY_DELIVERY_POSTCODE=

# Etsy: create an app at https://www.etsy.com/developers/your-apps
# Both the keystring AND the shared secret are required.
ETSY_API_KEY=
ETSY_SHARED_SECRET=
