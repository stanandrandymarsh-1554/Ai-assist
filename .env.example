# eBay: create a "Production" keyset at https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional: EBAY_US (default), EBAY_GB, EBAY_DE, EBAY_AU, EBAY_CA, ...
EBAY_MARKETPLACE=EBAY_US
# Optional: production (default) or sandbox
EBAY_ENV=production
# Optional: ZIP/postal code so eBay can estimate shipping to you, e.g. "US,10001"
EBAY_DELIVERY_LOCATION=

# Etsy: create an app at https://www.etsy.com/developers/your-apps
# Both the keystring AND the shared secret are required.
ETSY_API_KEY=
ETSY_SHARED_SECRET=
